# ===================================
# CONFIGURAÇÃO DO SUPABASE
# ===================================

# URL do projeto Supabase (encontrado em Settings > API > Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública/anon do Supabase (encontrada em Settings > API > Project API keys > anon public)
SUPABASE_KEY=sua-chave-anon-publica-aqui

# ===================================
# BANCO DE DADOS POSTGRESQL
# ===================================

# URL de conexão PostgreSQL do Supabase (encontrada em Settings > Database > Connection string > URI)
# Formato: postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:sua-senha-do-banco@db.seu-projeto.supabase.co:5432/postgres

# ===================================
# OPENAI API (para IA Consultora)
# ===================================

OPENAI_API_KEY=sk-sua-chave-openai-aqui

# ===================================
# SEGURANÇA
# ===================================

# Chave secreta para JWT (gere uma string aleatória forte)
SECRET_KEY=gere-uma-string-aleatoria-segura-aqui

# ===================================
# AMBIENTE
# ===================================

ENVIRONMENT=development
